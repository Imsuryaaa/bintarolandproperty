<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Mencegah perulangan pengalihan
    RewriteCond %{REQUEST_URI} !^/public/
    
    # Mengalihkan semua request pengunjung agar masuk ke folder public
    RewriteRule ^(.*)$ public/$1 [L]

     # Force sitemap.xml and robots.txt through Laravel
    RewriteRule ^sitemap\.xml$ index.php [L]
    RewriteRule ^robots\.txt$ index.php [L]
</IfModule>